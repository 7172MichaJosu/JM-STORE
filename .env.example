# Configuración local. Copiar solo si .env aún no existe.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3001
# Ruta absoluta, persistente y fuera del repositorio. El directorio se crea al arrancar.
SQLITE_PATH=C:/JM-STORE-datos/catalogo.sqlite
# Ejecutar npm run configurar-acceso. Sin acceso predeterminado.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Agregar un número comercial autorizado en formato +E.164. Vacío deshabilita pedidos.
WHATSAPP_NUMBER=
