{
  "name": "jm-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --host localhost --port 5173 --strictPort",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "configurar-acceso": "node scripts/configurar-acceso.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:e2e": "npm run build && node tests/fixtures/ejecutar-web.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "libphonenumber-js": "1.13.15",
    "multer": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
